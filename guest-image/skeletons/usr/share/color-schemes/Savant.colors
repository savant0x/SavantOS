# KDE color scheme — Savant traffic lights (dark).
#
# Generated from the canonical Savant Cyberpunk palette (savant-code
# cli/src/utils/theme-system/palette.ts). Background is the deep void
# #050508; accent cyan #18faf9; the traffic lights are #39ff14 (success),
# #ff9500 (warning), #ff2d55 (error). Selection is the hover lift #14141c
# brightened for legibility.
#
# Format: KConfig INI with the [Color:...] group scheme Plasma/KWin read.
# Views/Window/Selection/Tooltip/WM use the standard 10-slot scheme
# (BackgroundNormal, ForegroundNormal, + the 8 role pairs).

[General]
ColorSchemeHash=savant.colors
Name=Savant

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
Color=112,111,116
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=20,20,28
BackgroundNormal=11,11,17
DecorationFocus=24,250,249
DecorationHover=24,250,249
ForegroundActive=232,232,239
ForegroundInactive=138,138,150
ForegroundLink=59,130,246
ForegroundNegative=255,45,85
