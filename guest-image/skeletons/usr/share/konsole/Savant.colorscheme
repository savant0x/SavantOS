# Konsole color scheme — Savant traffic lights (dark).
#
# Mirrors the Savant KDE color scheme: void #050508 background, #e4e4e8
# foreground, cyan #18faf9 accents, the three lights for the semantic
# terminal colors. Format is Konsole's standard .colorscheme INI.

[Background]
Color=5,5,8
ColorMode=Normal
Opacity=1

[BackgroundIntense]
Color=11,11,17
ColorMode=Normal
Opacity=1

[Color0]
Color=11,11,17
ColorMode=Normal

[Color0Intense]
Color=138,138,150
ColorMode=Normal

[Color1]
Color=255,45,85
ColorMode=Normal

[Color1Intense]
Color=255,92,125
ColorMode=Normal

[Color2]
Color=57,255,20
ColorMode=Normal

[Color2Intense]
Color=109,255,82
ColorMode=Normal

[Color3]
Color=255,149,0
ColorMode=Normal

[Color3Intense]
Color=255,179,64
ColorMode=Normal

[Color4]
Color=24,201,249
ColorMode=Normal

[Color4Intense]
Color=92,216,255
ColorMode=Normal

[Color5]
Color=200,116,255
ColorMode=Normal

[Color5Intense]
Color=219,163,255
ColorMode=Normal

[Color6]
Color=24,250,249
ColorMode=Normal

[Color6Intense]
Color=92,252,255
ColorMode=Normal

[Color7]
Color=138,138,150
ColorMode=Normal

[Color7Intense]
Color=232,232,239
ColorMode=Normal

[Foreground]
Color=232,232,239
ColorMode=Normal

[ForegroundIntense]
Color=255,255,255
ColorMode=Normal

[General]
Blur=false
ColorRandomization=false
Description=Savant
Opacity=1
Wallpaper=
