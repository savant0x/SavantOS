dist/
*.ppm
*.log
*.iso
*.raw
*.ext4
*.zst
.wrangler/
__pycache__/
*.pyc

# Build outputs
/SavantOS*.exe
/SavantOS*.exe.sha256
/app/SavantOS*.exe
/app/SavantOS*.exe.sha256
/artifacts/

# Node toolchain — docs gate (markdownlint via bun); bun.lock IS tracked
node_modules/
# Secrets and agent credentials — never commit
.env
.env.*
*.pem
*.key

# Savant harness state
.savant/

# guest-image builder local state (volumes/cache live in Docker; host-side
# only build outputs land here)
guest-image/out/
guest-image/build-*/
guest-image/work/
guest-image-ws/
guest-image/mkosi-cache/
# savant-core is cross-compiled into the skeleton tree by build.sh before
# each assembly (FID-2026-0915-005) — generated, never committed.
guest-image/skeletons/usr/bin/savant-core
guest-image/.gocache/

# Brand assets live in assets/ (tracked); PNG exceptions above removed so
# docs/ and assets/ images stay versioned.
!docs/images/**
!assets/**

# Operator-local reference material and session artifacts — not product content
lastses.md
ses.md
sesh.md
SCOPE.md
savant-docs/
# vendored at build time by fetch_cursor (FID-2026-0916-002)
guest-image/skeletons/usr/bin/cursor
