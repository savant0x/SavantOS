diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial b/guest/factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial
new file mode 100755
index 0000000..e464b39
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial
@@ -0,0 +1,74 @@
+#!/bin/bash
+# Create the explicit SavantOS trial account without stopping at the
+# interactive first-boot form. This runs only when the Windows launcher adds
+# savantos.instant=1 to the kernel command line.
+set -euo pipefail
+
+provisioning_dir=/var/lib/omarchy/provisioning
+omarchy_path=${OMARCHY_PATH:-/usr/share/omarchy}
+log_file=/var/log/omarchy-provision-owner.log
+username=savant
+
+[[ -f $provisioning_dir/pending ]] || exit 0
+[[ ! -f $provisioning_dir/wipe-pending ]] || exit 1
+
+user_groups() {
+  local groups=wheel group
+  if [[ -f $provisioning_dir/groups ]]; then
+    while IFS= read -r group; do
+      [[ -n $group && $group != docker ]] || continue
+      getent group "$group" >/dev/null || continue
+      [[ ,$groups, == *,$group,* ]] || groups+=",$group"
+    done <"$provisioning_dir/groups"
+  fi
+  printf '%s\n' "$groups"
+}
+
+echo "[$(date '+%Y-%m-%d %H:%M:%S')] instant trial: creating $username" >>"$log_file"
+if getent passwd "$username" >/dev/null; then
+  usermod -aG "$(user_groups)" "$username"
+else
+  useradd -m -G "$(user_groups)" -s /bin/bash -c "SavantOS" "$username"
+fi
+
+# The VM window is the trial account's security boundary. A known password
+# keeps the lock screen usable, while passwordless sudo avoids putting a
+# credential hurdle in front of a disposable local trial.
+printf '%s:%s\n' "$username" savant | chpasswd
+cat >"/etc/sudoers.d/00-savantos-trial" <<SUDOERS
+$username ALL=(ALL:ALL) NOPASSWD: ALL
+SUDOERS
+chmod 440 /etc/sudoers.d/00-savantos-trial
+
+mkdir -p /var/lib/sddm /etc/sddm.conf.d /var/lib/savantos
+printf '[Last]\nSession=omarchy.desktop\nUser=%s\n' "$username" >/var/lib/sddm/state.conf
+chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true
+printf '[Autologin]\nUser=%s\nSession=omarchy.desktop\n' "$username" >/etc/sddm.conf.d/autologin.conf
+printf 'instant-trial\n' >/var/lib/savantos/provision-mode
+hostnamectl set-hostname savantos >>"$log_file" 2>&1 || printf 'savantos\n' >/etc/hostname
+
+home=$(getent passwd "$username" | cut -d: -f6)
+shell=$(getent passwd "$username" | cut -d: -f7)
+if ! runuser -u "$username" -- env \
+  HOME="$home" \
+  USER="$username" \
+  LOGNAME="$username" \
+  SHELL="${shell:-/bin/bash}" \
+  OMARCHY_PATH="$omarchy_path" \
+  OMARCHY_INSTALL="$omarchy_path/install" \
+  OMARCHY_SETUP_CONTEXT=provision-owner \
+  OMARCHY_USER_NAME="SavantOS" \
+  OMARCHY_USER_EMAIL="" \
+  OMARCHY_INSTALL_LOG_FILE="$log_file" \
+  OMARCHY_LOG_TO_STDOUT=1 \
+  "$omarchy_path/bin/omarchy-provision-user" --force --first-install >>"$log_file" 2>&1; then
+  echo "[$(date '+%Y-%m-%d %H:%M:%S')] instant trial: user finalization reported errors" >>"$log_file"
+fi
+
+rm -f "$provisioning_dir/pending" "$provisioning_dir/authorized_keys" "$provisioning_dir/setup-user"
+rm -f /etc/systemd/system/multi-user.target.wants/omarchy-provision-owner.service
+rm -f /etc/systemd/system/graphical.target.wants/omarchy-provision-autologin-once.service \
+  /etc/systemd/system/omarchy-provision-autologin-once.service
+systemctl daemon-reload 2>/dev/null || true
+sync
+echo "[$(date '+%Y-%m-%d %H:%M:%S')] instant trial: complete" >>"$log_file"
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/provision-owner b/guest/factory-overlay/usr/local/lib/try-omarchy/provision-owner
new file mode 100755
index 0000000..4f4ddb3
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/provision-owner
@@ -0,0 +1,8 @@
+#!/bin/bash
+set -euo pipefail
+
+if grep -qw 'savantos.instant=1' /proc/cmdline; then
+  exec /usr/local/lib/try-omarchy/provision-instant-trial
+fi
+
+exec /usr/bin/omarchy-provision-owner
diff --git a/guest/factory-overlay/etc/systemd/user/graphical-session.target.wants/savantos-welcome.service b/guest/factory-overlay/etc/systemd/user/graphical-session.target.wants/savantos-welcome.service
new file mode 120000
index 0000000..925ba12
--- /dev/null
+++ b/guest/factory-overlay/etc/systemd/user/graphical-session.target.wants/savantos-welcome.service
@@ -0,0 +1 @@
+../savantos-welcome.service
\ No newline at end of file
diff --git a/guest/factory-overlay/etc/systemd/user/savantos-welcome.service b/guest/factory-overlay/etc/systemd/user/savantos-welcome.service
new file mode 100644
index 0000000..2a9feca
--- /dev/null
+++ b/guest/factory-overlay/etc/systemd/user/savantos-welcome.service
@@ -0,0 +1,12 @@
+[Unit]
+Description=Show the SavantOS instant-account welcome
+After=graphical-session.target
+PartOf=graphical-session.target
+ConditionPathExists=/var/lib/savantos/provision-mode
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/lib/try-omarchy/show-welcome
+
+[Install]
+WantedBy=graphical-session.target
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/show-welcome b/guest/factory-overlay/usr/local/lib/try-omarchy/show-welcome
new file mode 100755
index 0000000..0bb39fc
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/show-welcome
@@ -0,0 +1,26 @@
+#!/bin/bash
+set -u
+
+[[ $(cat /var/lib/savantos/provision-mode 2>/dev/null) == instant-trial ]] || exit 0
+
+state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/savantos
+marker=$state_dir/welcome-shown
+[[ ! -e $marker ]] || exit 0
+
+body=$'Trial login: savant    Password: savant\nSudo does not require a password.\n\nSUPER+SPACE opens the menu.  SUPER+K shows all keybindings.'
+for attempt in {1..30}; do
+  if notify-send \
+    --app-name='SavantOS' \
+    --urgency=normal \
+    --expire-time=30000 \
+    'Welcome to SavantOS' \
+    "$body"; then
+    mkdir -p "$state_dir"
+    touch "$marker"
+    exit 0
+  fi
+  sleep 1
+done
+
+# Try again next login if the notification service never became ready.
+exit 0
diff --git a/guest/tests/verify.py b/guest/tests/verify.py
index ce3eba4..f553e99 100755
--- a/guest/tests/verify.py
+++ b/guest/tests/verify.py
@@ -80,6 +80,54 @@ def main() -> None:
     )
     check("cmp -s" not in configure, "rootfs configuration uses only declared build tools")
 
+    provision_dispatch = read(
+        GUEST / "factory-overlay/usr/local/lib/try-omarchy/provision-owner"
+    )
+    instant_trial = read(
+        GUEST / "factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial"
+    )
+    provision_override = read(
+        GUEST
+        / "factory-overlay/etc/systemd/system/omarchy-provision-owner.service.d/20-savantos.conf"
+    )
+    welcome = read(
+        GUEST / "factory-overlay/usr/local/lib/try-omarchy/show-welcome"
+    )
+    welcome_service = read(
+        GUEST / "factory-overlay/etc/systemd/user/savantos-welcome.service"
+    )
+    check(
+        "savantos.instant=1" in provision_dispatch
+        and "/usr/bin/omarchy-provision-owner" in provision_dispatch,
+        "first boot dispatches explicit instant mode without changing normal provisioning",
+    )
+    check(
+        "ExecStart=/usr/local/lib/try-omarchy/provision-owner" in provision_override,
+        "owner provisioning uses the SavantOS dispatcher",
+    )
+    check(
+        "useradd -m" in instant_trial
+        and "omarchy-provision-user" in instant_trial
+        and "NOPASSWD: ALL" in instant_trial
+        and "User=%s" in instant_trial,
+        "instant mode creates, finalizes, and autologs into its trial account",
+    )
+    check(
+        "root:" not in instant_trial and "sshd" not in instant_trial,
+        "instant mode does not enable root or remote login",
+    )
+    check(
+        "notify-send" in welcome
+        and "Trial login: savant" in welcome
+        and "Password: savant" in welcome
+        and "welcome-shown" in welcome,
+        "instant mode shows the trial credentials once on the first desktop",
+    )
+    check(
+        "ConditionPathExists=/var/lib/savantos/provision-mode" in welcome_service,
+        "the welcome service is limited to explicit instant-mode guests",
+    )
+
     finalizer = read(GUEST / "scripts/finalize-rootfs.sh")
     check("factory" in finalizer and "x86_64" in finalizer, "finalizer enforces the native factory contract")
     check("systemd-growfs-root.service" in finalizer, "factory disk grows on first boot")
