diff --git a/guest/factory-overlay/etc/systemd/system/omarchy-provision-owner.service.d/20-savantos.conf b/guest/factory-overlay/etc/systemd/system/omarchy-provision-owner.service.d/20-savantos.conf
index 6cd0cfa..9b4e2dd 100644
--- a/guest/factory-overlay/etc/systemd/system/omarchy-provision-owner.service.d/20-savantos.conf
+++ b/guest/factory-overlay/etc/systemd/system/omarchy-provision-owner.service.d/20-savantos.conf
@@ -2,4 +2,6 @@
 # installs), so keep the autologin provisioning writes instead of letting the
 # one-boot cleanup unit drop it — the generic SDDM greeter must never appear.
 [Service]
+ExecStart=
+ExecStart=/usr/local/lib/try-omarchy/provision-owner
