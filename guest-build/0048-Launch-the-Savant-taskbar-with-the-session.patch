diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index d9dc1f8..2e6a353 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -69,6 +69,7 @@ compat_paths=(
   etc/systemd/system/savantos-catch-up.service
   etc/systemd/system/multi-user.target.wants/savantos-catch-up.service
   usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
+  usr/share/try-omarchy/skel-fragments/hypr-autostart-savant.append.lua
   etc/systemd/user/savantos-share-link.service
   etc/systemd/user/graphical-session.target.wants/savantos-share-link.service
   etc/systemd/user/savantos-factory-update-notice.service
@@ -90,7 +91,7 @@ kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '
 }
 # Bump this revision whenever compat-overlay.tar changes in a way that must be
 # applied to persistent disks created by an earlier launcher release.
-compat_revision=12
