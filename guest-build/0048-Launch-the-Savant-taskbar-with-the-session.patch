diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
index 8527750..931c496 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
@@ -16,6 +16,8 @@ state_dir=${TRY_SAVANTOS_STATE_DIR:-/var/lib/savantos}
 fragment=${TRY_SAVANTOS_QEMU_FRAGMENT:-/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua}
 omarchy_default=${TRY_SAVANTOS_OMARCHY_MONITORS:-/usr/share/omarchy/config/hypr/monitors.lua}
 toggle_templates=${TRY_SAVANTOS_TOGGLE_TEMPLATES:-/usr/share/omarchy/default/hypr/toggles}
+autostart_default=${TRY_SAVANTOS_OMARCHY_AUTOSTART:-/usr/share/omarchy/config/hypr/autostart.lua}
+autostart_fragment=${TRY_SAVANTOS_AUTOSTART_FRAGMENT:-/usr/share/try-omarchy/skel-fragments/hypr-autostart-savant.append.lua}
 homes=${TRY_SAVANTOS_HOMES:-/home}
 
 revision=$(cut -d: -f1 "$revision_file" 2>/dev/null || echo 0)
@@ -23,6 +25,12 @@ marker="$state_dir/catch-up-revision"
 [[ "$(cat "$marker" 2>/dev/null || true)" != "$revision" ]] || exit 0
 mkdir -p "$state_dir"
 
+strip_savant_block() {
+  # Drop our appended taskbar block so the remainder can be compared with Omarchy's own file.
+  sed '/^-- BEGIN SAVANTOS TASKBAR$/,/^-- END SAVANTOS TASKBAR$/d' "$1" | sed -e :a -e '/^
+*$/{$d;N;ba' -e '}'
+}
+
 strip_profile_block() {
   # Drop our appended block so the remainder can be compared with Omarchy's own file.
   sed '/^-- BEGIN OMARCHY QEMU PROFILE$/,/^-- END OMARCHY QEMU PROFILE$/d' "$1" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
@@ -48,6 +56,27 @@ refresh_monitors() {
   echo "refreshed the QEMU profile in $file"
 }
 
+refresh_autostart() {
+  local home=$1 file=$1/.config/hypr/autostart.lua
+  [[ -f $file && -f $autostart_default && -f $autostart_fragment ]] || return 0
+  grep -q "^-- BEGIN SAVANTOS TASKBAR$" "$file" || return 0
+  if ! cmp -s <(strip_savant_block "$file") <(sed -e :a -e '/^
+*$/{$d;N;ba' -e '}' "$autostart_default"); then
+    return 0
+  fi
+  local tmp
+  tmp=$(mktemp "$(dirname "$file")/.autostart.lua.XXXXXX")
+  cat "$autostart_default" "$autostart_fragment" >"$tmp"
+  if cmp -s "$tmp" "$file"; then
+    rm -f "$tmp"
+    return 0
+  fi
+  chown --reference="$file" "$tmp"
+  chmod --reference="$file" "$tmp"
+  mv -f "$tmp" "$file"
+  echo "refreshed the Savant taskbar autostart in $file"
+}
+
 remove_seeded_toggles() {
   local dir=$1/.local/state/omarchy/toggles/hypr flags=$1/.local/state/omarchy/toggles/hypr/flags.lua name
   [[ -f $flags ]] || return 0
@@ -74,6 +103,7 @@ enable_suspend_off() {
 for home in "$homes"/*; do
   [[ -d $home/.config/hypr ]] || continue
   refresh_monitors "$home" || true
+  refresh_autostart "$home" || true
   remove_seeded_toggles "$home" || true
   enable_suspend_off "$home" || true
 done
diff --git a/guest/factory-overlay/usr/share/omarchy/install/user/theme.sh b/guest/factory-overlay/usr/share/omarchy/install/user/theme.sh
new file mode 100644
index 0000000..b0f2a17
--- /dev/null
+++ b/guest/factory-overlay/usr/share/omarchy/install/user/theme.sh
@@ -0,0 +1,16 @@
+# Setup user theme folder and seed the default only when no theme exists yet.
+mkdir -p ~/.config/omarchy/themes
+
+if [[ ! -s $HOME/.local/state/omarchy/current/theme.name ]]; then
+  # iso-chroot and provision-owner both run without a live session to notify.
+  if [[ ${OMARCHY_SETUP_CONTEXT:-runtime} != "runtime" ]]; then
+    OMARCHY_THEME_HEADLESS=1 omarchy-theme-set "Savant"
+    rm -f ~/.config/chromium/SingletonLock # otherwise archiso owns the Chromium singleton
+  else
+    omarchy-theme-set "Savant"
+  fi
+fi
+omarchy-theme-set-pi --activate
+
+mkdir -p ~/.config/btop/themes
+ln -snf "$HOME/.local/state/omarchy/current/theme/btop.theme" ~/.config/btop/themes/current.theme
diff --git a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-autostart-savant.append.lua b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-autostart-savant.append.lua
new file mode 100644
index 0000000..4fc44cd
--- /dev/null
+++ b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-autostart-savant.append.lua
@@ -0,0 +1,6 @@
+
+-- BEGIN SAVANTOS TASKBAR
+-- Launch the Savant taskbar (waybar) with the session. System-wide defaults
+-- live at /etc/xdg/waybar; users override them at ~/.config/waybar.
+o.launch_on_start("waybar")
+-- END SAVANTOS TASKBAR
