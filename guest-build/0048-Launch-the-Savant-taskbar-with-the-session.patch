         and "usr/local/lib/try-omarchy/catch-up" in finalize_rootfs
         and "usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua" in finalize_rootfs
+        and "usr/share/try-omarchy/skel-fragments/hypr-autostart-savant.append.lua" in finalize_rootfs
         and "etc/systemd/user/omarchy-fcitx5.service.d/10-savantos.conf" in finalize_rootfs
         and "usr/local/lib/try-omarchy/agent" in finalize_rootfs
         and "compat_revision" in finalize_rootfs.split("compat-version")[0]
